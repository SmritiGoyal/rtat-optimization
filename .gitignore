outputs/interim/*.csv
outputs/features/*.parquet
outputs/features/*.csv
outputs/eda/*.csv
outputs/eda/*.png
outputs/models/*.pkl
outputs/models/*.csv
outputs/prioritization/*.csv

# Keep the placeholder README so empty folders show in repo
!outputs/README.md
!outputs/*/README.md

